# SafeHer Campus Backend Configuration Template
# Copy this file to .env and provide your deployment/environment values.
# NEVER commit the real .env file or real secrets to version control.

NODE_ENV=production
PORT=3000
API_PREFIX=api/v1

# Central PostgreSQL Database URL (e.g. from Render PostgreSQL)
DATABASE_URL=postgresql://<DB_USER>:<DB_PASSWORD>@<DB_HOST>:5432/<DB_NAME>?sslmode=require

# Authentication Secrets (Generate secure random 64+ char strings for production)
JWT_SECRET=replace_with_a_secure_random_jwt_secret_key
JWT_EXPIRATION=15m
JWT_REFRESH_SECRET=replace_with_a_secure_random_refresh_secret_key
JWT_REFRESH_EXPIRATION=7d

# S3 Compatible Evidence Storage (AWS S3 / MinIO / Cloudflare R2)
S3_ENDPOINT=https://s3.amazonaws.com
S3_REGION=us-east-1
S3_BUCKET_NAME=safeher-evidence-vault
S3_ACCESS_KEY=replace_with_s3_access_key
S3_SECRET_KEY=replace_with_s3_secret_key

# Redis Configuration (Optional / Queue & Rate Limiting)
REDIS_HOST=localhost
REDIS_PORT=6379

# Firebase Cloud Messaging (Optional)
FCM_SERVER_KEY=replace_with_fcm_server_key

# Statutory Campus Emergency & Helpline Numbers
CAMPUS_SECURITY_EMERGENCY_NUMBER=+911122334455
NATIONAL_WOMEN_HELPLINE=1091
NATIONAL_EMERGENCY_HELPLINE=112
